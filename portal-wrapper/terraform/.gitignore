# Terraform state (may contain secrets and rendered config)
*.tfstate
*.tfstate.*
.terraform/
crash.log
crash.*.log
terraform.tfplan
*.tfplan

# Local backend config (holds the real bucket name) and secret var files.
# Match any *.s3.hcl (incl. typos like backens.s3.hcl) but keep the template.
*.s3.hcl
!*.s3.hcl.example
*.tfvars
*.tfvars.json
!*.tfvars.example
# rc-*.tfvars hold no secrets (naming/domain config only) — keep them tracked
!rc-*.tfvars

# Build and generated artifacts
build/
generated-configs/
*.zip

# Keep the provider lock file committed (.terraform.lock.hcl is intentionally tracked)
*.csv
