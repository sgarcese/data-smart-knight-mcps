# Encrypted remote state backend for shared/production use.
#
# Copy to backend.s3.hcl (gitignored), fill in your values, then init with:
#   terraform init -backend-config=backend.s3.hcl
#
# The bucket must already exist (provision it once, separately). Remote state is
# strongly recommended because state holds portal_app_tokens and the rendered
# config in plaintext, so the bucket must be encrypted.

bucket  = "rc-tfstate-564762345093"  # Responsive Cities state bucket (see phila-mcp/terraform/bootstrap)
key     = "rc/data-smart/portal-wrapper/terraform.tfstate"
region  = "us-east-1"
encrypt = true

# State locking via the Responsive Cities lock table (created by the
# phila-mcp bootstrap). Prevents two concurrent applies from corrupting state.
dynamodb_table = "rc-terraform-state-lock"
