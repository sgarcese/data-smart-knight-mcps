server_name: "${city} OpenData MCP"
description: "OpenData MCP for ${city}"
organization: "${city}"
plugins:
  ${plugin_type}:
    enabled: true
    portal_url: "${url}"
    city_name: "${city}"
    timeout: 120
aws:
  region: "${aws_region}"
  lambda_name: "${lambda_name}"
  lambda_memory: ${lambda_memory}
  lambda_timeout: ${lambda_timeout}
logging:
  level: "INFO"
  format: "json"
