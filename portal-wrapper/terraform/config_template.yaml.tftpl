server_name: "${city} OpenData MCP"
description: "OpenData MCP for ${city}%{ if warning != "" } — WARNING: ${warning}%{ endif }"
organization: "${city}"
plugins:
  ${plugin_type}:
    enabled: true
    portal_url: "${url}"
%{ if plugin_type != "arcgis" ~}
    base_url: "${url}"
%{ endif ~}
    city_name: "${city}"
%{ if plugin_type == "socrata" ~}
    app_token: "${app_token}"
%{ endif ~}
    timeout: ${timeout}
aws:
  region: "${aws_region}"
  lambda_name: "${lambda_name}"
  lambda_memory: ${lambda_memory}
  lambda_timeout: ${lambda_timeout}
logging:
  level: "INFO"
  format: "json"
